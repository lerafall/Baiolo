BAIOLO_DOMAIN=baiolo.com
NEXT_PUBLIC_SITE_URL=https://baiolo.com
SITE_URL=https://baiolo.com
TRAEFIK_NETWORK=traefik-net
TRAEFIK_ENTRYPOINT_HTTPS=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

BAIOLO_ADMIN_CODE=
# Do not set NEXT_PUBLIC_BAIOLO_ADMIN_CODE — it used to authorize admin APIs from the browser bundle.

# Contact for Pro/Studio upgrade requests (mailto from /pricing)
NEXT_PUBLIC_BAIOLO_CONTACT_EMAIL=hello@baiolo.com

# Billing provider: manual (default) until Stripe/etc. is wired
# BAIOLO_BILLING_PROVIDER=manual

# AI — OpenRouter preferred (production path A)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_FAST=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_QUALITY=anthropic/claude-sonnet-5

# Or direct OpenAI instead:
# OPENAI_API_KEY=
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_QUALITY=gpt-4o

# Optional external builder (path B) — leave unset to use OpenRouter/OpenAI
# BUILDER_API_URL=https://builder.example.com/build
# BUILDER_API_SECRET=
# BUILDER_HEALTH_URL=https://builder.example.com/health

# Moderation / invite / share emails (Resend)
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=Baiolo <hello@baiolo.com>
