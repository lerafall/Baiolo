# Copy to .env.local and fill in when you have a Supabase project.
# Without these, Baiolo runs fully on the local mock store.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server key for admin/pipeline/storage jobs (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Demo admin gate for /admin (local only)
BAIOLO_ADMIN_CODE=baiolo-admin
NEXT_PUBLIC_BAIOLO_ADMIN_CODE=baiolo-admin

# AI for Create “Build from description” + optional admin code review
# Prefer OpenRouter (many models, one key): https://openrouter.ai/
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Or direct OpenAI instead of OpenRouter
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional path B: external builder API (same JSON shape as /api/build)
# BUILDER_API_URL=
# BUILDER_API_SECRET=

# After creating a Supabase project:
# 1. Run supabase/schema.sql, schema-v2.sql, then schema-v3.sql
# 2. Create storage buckets: project-private (private), project-public (public)
# 3. Auth → enable Email; add redirect URL …/auth/callback
# 4. Paste URL + keys above and restart `npm run dev`
# 5. See docs/GO_LIVE.md for the full checklist
# 6. GET /api/health should report mode: "supabase"
