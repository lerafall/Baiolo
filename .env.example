# Copy to .env.local and fill in when you have a Supabase project.
# Without these, Baiolo runs fully on the local mock store.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional server key for admin/pipeline/storage jobs (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Demo admin gate for /admin (local only)
BAIOLO_ADMIN_CODE=baiolo-admin
NEXT_PUBLIC_BAIOLO_ADMIN_CODE=baiolo-admin

# AI — OpenRouter preferred (cheap + strong models on one key)
OPENROUTER_API_KEY=
# Cheap / fast: code review + simple builds (timer, tap, counter…)
OPENROUTER_MODEL_FAST=openai/gpt-4o-mini
# Stronger: richer games / longer prompts
OPENROUTER_MODEL_QUALITY=openai/gpt-4o
# Optional single fallback if FAST/QUALITY unset:
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Or direct OpenAI instead of OpenRouter
# OPENAI_API_KEY=
# OPENAI_MODEL_FAST=gpt-4o-mini
# OPENAI_MODEL_QUALITY=gpt-4o

# Optional path B: external builder API (same JSON shape as /api/build)
# BUILDER_API_URL=
# BUILDER_API_SECRET=
# BUILDER_HEALTH_URL=
# Local stub: node scripts/builder-stub.mjs  →  BUILDER_API_URL=http://127.0.0.1:8787/build

# Optional env gates when Supabase is not configured (mock mode)
# Production limits now come from `src/lib/plans.config.ts`.
# BAIOLO_PRO_USER_IDS=
# BAIOLO_PRO_EMAILS=
# BAIOLO_STUDIO_USER_IDS=
# BAIOLO_STUDIO_EMAILS=

# Optional email notifications (Resend)
# RESEND_API_KEY=
# NOTIFY_EMAIL_FROM=Baiolo <hello@yourdomain.com>

# Contact for Pro/Studio upgrade requests (mailto from /pricing)
# NEXT_PUBLIC_BAIOLO_CONTACT_EMAIL=hello@baiolo.com
# BAIOLO_BILLING_PROVIDER=manual

# After creating a Supabase project:
# 1. Run supabase/schema.sql, schema-v2.sql, schema-v3.sql, then schema-v4.sql, schema-v5.sql, schema-v6.sql
# 2. Create storage buckets: project-private (private), project-public (public)
# 3. Auth → enable Email; add redirect URL …/auth/callback
# 4. Paste URL + keys above and restart `npm run dev`
# 5. See docs/GO_LIVE.md for the full checklist
# 6. GET /api/health should report mode: "supabase"
